#!/usr/bin/env bash
# Pre-commit: keep the two out-of-repo copies fresh, then gate on the fixture.
#
# Lives in hooks/ and is TRACKED, because .git/hooks is not cloned and a hook nobody has is
# worse than no hook - it looks like a guarantee and is not one. Enabled with:
#
#     git config core.hooksPath hooks
#
# which is a one-off per clone. `git commit --no-verify` skips it.
#
# It does two things, in this order:
#
#   1. ./sync_docs.sh check - reports whether the repo's copies of ~/.claude's SKILL.md and
#      memory/ have drifted, and BLOCKS the commit if they have. It changes nothing: no file
#      is written, nothing is staged.
#
#      This hook does NOT widen your commit (Chris, 26.08.2026: "make it check instead of
#      pulling, don't widen my commits"). It briefly did pull-and-stage, which kept the
#      backup fresh for free but meant any commit could silently acquire unrelated SKILL.md
#      or memory churn - and memory/ is rewritten by Claude across sessions, so that churn
#      arrives without you having touched anything. A commit now contains exactly what you
#      staged; if the copies are stale you are told, and you run ./sync_docs.sh yourself.
#
#   2. python3 run_tests.py --known-red known_red.txt - 0.84s, and it is the only thing
#      standing between a pattern edit and a silently wrong briefing at 6am. A failing
#      fixture blocks the commit - UNLESS every failure is waived in known_red.txt.
#
#      The waiver exists because these two steps used to share one fate (10.09.2026).
#      testcases.txt works failing-first, so the fixture is legitimately red for as long as
#      a correction waits for its fix; the cross-section RANBEFORE case sat red from 08.09.
#      For those two days every commit needed --no-verify, and --no-verify skips step 1 as
#      well - so a deliberate red case was quietly switching off the drift guard on
#      SKILL.md and memory/, the two files this repo calls the least replaceable it has.
#      Both gates still block. What changed is that a KNOWN red no longer forces you to
#      bypass the other one, while a NEW red blocks exactly as before, and a waiver that
#      has stopped matching anything is itself a failure so the list cannot rot.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: sync_docs.sh check"
if ! ./sync_docs.sh check > /tmp/precommit-sync.log 2>&1; then
    sed 's/^/  /' /tmp/precommit-sync.log
    echo "pre-commit: SKILL.md or memory/ has drifted - commit aborted." >&2
    echo "            Run ./sync_docs.sh, then commit the result as its own change." >&2
    echo "            Or --no-verify if this commit is deliberately unrelated." >&2
    exit 1
fi

echo "pre-commit: run_tests.py --known-red known_red.txt"
if ! python3 run_tests.py --known-red known_red.txt > /tmp/precommit-tests.log 2>&1; then
    tail -24 /tmp/precommit-tests.log | sed 's/^/  /'
    echo "pre-commit: FIXTURE FAILED - commit aborted. Full log: /tmp/precommit-tests.log" >&2
    echo "            Either fix it, or - if it is red on purpose - add it to known_red.txt" >&2
    echo "            with the date and what has to be true before the waiver is deleted." >&2
    echo "            Prefer that to --no-verify: --no-verify also skips the drift check" >&2
    echo "            above, which is how a red fixture came to disarm the SKILL.md and" >&2
    echo "            memory/ backup guard for two days (10.09.2026)." >&2
    exit 1
fi
tail -1 /tmp/precommit-tests.log | sed 's/^/  /'
echo "pre-commit: ok"
